{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trisynora.dev/v1/DecisionRecord.schema.json",
  "title": "TRISYNORA DecisionRecord v1",
  "description": "Structure only. Human authority and file-integrity require trusted runtime validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "trisynora/v1"
    },
    "record_type": {
      "const": "DecisionRecord"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "producer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "system",
        "reference",
        "sha256"
      ],
      "additionalProperties": false
    },
    "chosen_artifact_record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "candidate_artifact_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
      },
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true
    },
    "evaluation_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "event_id",
    "tenant_id",
    "project_id",
    "produced_at",
    "producer",
    "producer_version",
    "source",
    "chosen_artifact_record_id",
    "candidate_artifact_record_ids",
    "evaluation_record_ids",
    "rationale"
  ],
  "additionalProperties": false
}
