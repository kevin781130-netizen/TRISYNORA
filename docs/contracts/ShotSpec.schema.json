{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trisynora.dev/v1/ShotSpec.schema.json",
  "title": "TRISYNORA ShotSpec v1",
  "description": "Structure only. Human authority and file-integrity require trusted runtime validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "trisynora/v1"
    },
    "record_type": {
      "const": "ShotSpec"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "producer_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "system",
        "reference",
        "sha256"
      ],
      "additionalProperties": false
    },
    "project_spec_record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "shot_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"
    },
    "duration_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "fps_num": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "fps_den": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "event_id",
    "tenant_id",
    "project_id",
    "produced_at",
    "producer",
    "producer_version",
    "source",
    "project_spec_record_id",
    "shot_id",
    "duration_frames",
    "fps_num",
    "fps_den",
    "intent",
    "acceptance_criteria"
  ],
  "additionalProperties": false
}
